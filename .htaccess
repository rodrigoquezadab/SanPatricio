# Configuración del servidor (Hostinger / Apache-LiteSpeed)
# Parroquia San Patricio - https://parroquiasanpatricio.cl

# Página de error personalizada
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Dominio sin www. (HTTP -> HTTPS lo resuelve el CDN de Hostinger; no usar %{HTTPS} aquí:
    #    el CDN conecta al servidor por HTTP y la condición provoca un bucle de redirecciones.)
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^(.*)$ https://parroquiasanpatricio.cl/$1 [R=301,L]

    # 2. URLs antiguas de la carpeta /paginas/ -> raíz
    RewriteRule ^paginas/congregacion\.html$ /parroquia.html [R=301,L]
    RewriteRule ^paginas/(.+)$ /$1 [R=301,L]

    # 3. Página renombrada
    RewriteRule ^congregacion\.html$ /parroquia.html [R=301,L]

    # 4. Archivos internos del proyecto (documentación, herramientas, notas): no se sirven
    RewriteRule ^(docs|tools|\.claude)(/|$) - [R=404,L]
    RewriteRule \.md$ - [R=404,L]
</IfModule>

# Cabeceras de seguridad
<IfModule mod_headers.c>
    # Usar siempre HTTPS durante 1 año (sin includeSubDomains ni preload)
    Header always set Strict-Transport-Security "max-age=31536000"
    # Impedir que otros sitios muestren estas páginas dentro de un iframe
    Header always set X-Frame-Options "SAMEORIGIN"
    # No adivinar el tipo de archivo
    Header always set X-Content-Type-Options "nosniff"
    # Enviar solo el dominio al seguir enlaces externos
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
