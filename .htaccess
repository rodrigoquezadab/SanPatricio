# Configuración del servidor (Hostinger / Apache-LiteSpeed)
# Parroquia San Patricio - https://parroquiasanpatricio.cl

# Página de error personalizada
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Forzar HTTPS y dominio sin www (una sola redirección 301)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^(.*)$ https://parroquiasanpatricio.cl/$1 [R=301,L]

    # 2. URLs antiguas de la carpeta /paginas/ -> raíz
    RewriteRule ^paginas/congregacion\.html$ /parroquia.html [R=301,L]
    RewriteRule ^paginas/(.+)$ /$1 [R=301,L]

    # 3. Página renombrada
    RewriteRule ^congregacion\.html$ /parroquia.html [R=301,L]
</IfModule>
